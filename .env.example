# `make stack` creates .env when it is missing, with a fresh scrypt hash of
# PHOEBE_DEV_PASSWORD (default: larkspur-demo). This file only shows the format.
# PHOEBE_PASSWORD_HASH is an scrypt hash and contains `$`. Docker Compose
# interpolates `$` in .env values, so keep the value in SINGLE quotes (literal)
# or write each `$` as `$$`. Generate one with:
#   uv run python -m phoebe.auth 'your-password'
PHOEBE_PASSWORD_HASH='scrypt$32768$8$1$<salt>$<digest>'
# Host port for the API (the container always listens on 8080).
# PHOEBE_PORT=8080

# AI chat and spend safety (see the README Configuration table). Values
# below are the offline defaults; AWS-only settings stay commented out.
PHOEBE_EMBEDDER=hash
PHOEBE_AWS_REGION=us-east-2
PHOEBE_MAX_CHUNKS_PER_DOCUMENT=400
PHOEBE_LIMITS_BACKEND=memory
PHOEBE_CONTROL_BACKEND=file
PHOEBE_CONTROL_FILE=data/control.json
# PHOEBE_STATE_TABLE=   # AWS only
PHOEBE_KILL_SWITCH_CACHE_SECONDS=5
PHOEBE_CHAT_PER_SESSION_HOUR=30
PHOEBE_CHAT_GLOBAL_DAY=300
PHOEBE_UPLOADS_PER_SESSION_DAY=5
PHOEBE_UPLOADS_GLOBAL_DAY=50
PHOEBE_LOGIN_PER_IP_WINDOW=10
PHOEBE_LOGIN_WINDOW_SECONDS=900
# PHOEBE_CLIENT_IP_HEADER=
PHOEBE_QUESTION_MAX_CHARS=1000
PHOEBE_HISTORY_EXCHANGES=3
PHOEBE_HISTORY_TURN_MAX_CHARS=2000
PHOEBE_ANSWER_MAX_TOKENS=700
PHOEBE_ANSWER_MAX_CHARS=6000
# PHOEBE_REFUSAL_MIN_SIMILARITY=0.05   # unset: per-embedder default
PHOEBE_ANSWER_BACKEND=extractive
# PHOEBE_HARNESS_ARN=   # AWS only
PHOEBE_REWRITER_BACKEND=heuristic
# PHOEBE_REWRITE_MODEL_ID=us.amazon.nova-micro-v1:0   # AWS only
PHOEBE_REWRITE_MAX_TOKENS=64
# PHOEBE_GUARDRAIL_ID=   # AWS only
# PHOEBE_GUARDRAIL_VERSION=   # AWS only
