.superpowers/
.env
data/
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
# Per-env app inputs are ARNs and names only (no secrets), so they are committed.
!infra/app/envs/*.tfvars
!infra/bootstrap/terraform.tfvars
# Local-only overrides (e.g. the bootstrap first-apply local backend).
*_override.tf
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
# Release plan artifact written by ci/release-plan.sh.
release-out/
# make eval results (full answers; synthetic data, but kept local).
backend/evals/results/
# Saved Terraform plans from owner applies (e.g. infra/bootstrap/alerts.plan).
# They can hold sensitive values, such as the alert email.
*.plan
*.tfplan

frontend/capture-output
